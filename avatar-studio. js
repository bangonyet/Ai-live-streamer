    </div>
  </div>`;
  document.getElementById('s2')?.insertAdjacentHTML('afterend', s3Html);

  // Auto-Sync Firebase
  let fbAuth = null, fbDb = null, fbDoc = null, fbSetDoc = null;
  try {
    const d = String.fromCharCode(46);
    const u = "https://www" + d + "gstatic" + d + "com/firebasejs/10" + d + "12" + d + "2/";
    const { getApps } = await import(u + "firebase-app.js");
    const { getAuth, onAuthStateChanged } = await import(u + "firebase-auth.js");
    const { getFirestore, doc, getDoc, setDoc } = await import(u + "firebase-firestore.js");
    const app = getApps();
    if (app) {
      fbAuth = getAuth(app); fbDb = getFirestore(app); fbDoc = doc; fbSetDoc = setDoc;
      onAuthStateChanged(fbAuth, async user => {
        if (!user) return;
        const snap = await getDoc(doc(fbDb, 'creators', user.uid));
        if (snap.exists()) {
          const d = snap.data();
          if (d.avatarConfig) {
            Object.assign(avCfg, d.avatarConfig);
            document.getElementById('avZoomIn').value = Math.round(avCfg.zoom * 100);
            document.getElementById('avOffYIn').value = avCfg.offY;
            document.getElementById('avBrightIn').value = avCfg.bright;
          }
          if (d.avatarPhotoData && !rawImg) {
            window.setAvatarPhoto(d.avatarPhotoData, { x: 0.3, y: 0.2, width: 0.4, height: 0.4 }, 1, 1);
            document.getElementById('avCloudStat').innerText = '☁️ Avatar Tersimpan Dimuat';
          }
        }
      });
    }
  } catch (e) {}

  async function autoSaveAvatarCloud() {
    if (!fbAuth?.currentUser || !rawImg) return;
    try {
      const c = document.createElement('canvas');
      c.width = 240; c.height = 320;
      c.getContext('2d').drawImage(rawImg, 0, 0, 240, 320);
      await fbSetDoc(fbDoc(fbDb, 'creators', fbAuth.currentUser.uid), {
        avatarPhotoData: c.toDataURL('image/jpeg', 0.72),
        avatarConfig: avCfg,
        avatarUpdatedAt: Date.now()
      }, { merge: true });
      document.getElementById('avCloudStat').innerText = '☁️ Foto & Avatar Tersinkron';
    } catch (e) {}
  }

  window.saveAvatarAndNext = async function () {
    const btn = document.getElementById('btnSaveAv');
    btn.innerText = '⏳ Menyimpan...';
    await autoSaveAvatarCloud();
    btn.innerText = 'Simpan Avatar & Masuk Studio →';
    window.go(4);
  };

  // Engine Render Realistik
  const offCvs = document.createElement('canvas');
  function renderRealisticHost(targetCvs, isStudio) {
    if (!targetCvs || !rawImg) return;
    const ctx = targetCvs.getContext('2d');
    const w = targetCvs.width, h = targetCvs.height;
    offCvs.width = w; offCvs.height = h;
    const octx = offCvs.getContext('2d');

    const now = Date.now();
    const breath = 1 + Math.sin(now / 700) * 0.008;
    const swayX = Math.sin(now / 1200) * 2;
    const swayY = Math.cos(now / 850) * 1.5;

    if (now - lastBlink > 3800) { blinkVal = 1; lastBlink = now; }
    if (blinkVal > 0) blinkVal = Math.max(0, blinkVal - 0.14);

    const scale = Math.max(w / rawImg.width, h / rawImg.height) * avCfg.zoom * breath;
    const dw = rawImg.width * scale, dh = rawImg.height * scale;
    const dx = (w - dw) / 2 + swayX;
    const dy = (h - dh) / 2 + avCfg.offY * (isStudio ? 0.65 : 1) + swayY;

    octx.clearRect(0, 0, w, h);
    octx.save();
    octx.filter = `brightness(${avCfg.bright}%) contrast(105%) saturate(106%)`;
    octx.drawImage(rawImg, dx, dy, dw, dh);
    octx.filter = 'none';

    if (blinkVal > 0.1) {
      octx.fillStyle = `rgba(185, 140, 115, ${blinkVal * 0.85})`;
      octx.beginPath();
      octx.ellipse(w * 0.43 + swayX, h * 0.37 + swayY + avCfg.offY * 0.5, w * 0.035, h * 0.012 * blinkVal, 0, 0, Math.PI * 2);
      octx.ellipse(w * 0.57 + swayX, h * 0.37 + swayY + avCfg.offY * 0.5, w * 0.035, h * 0.012 * blinkVal, 0, 0, Math.PI * 2);
      octx.fill();
    }

    if (segMask && avCfg.blurBg) {
      octx.globalCompositeOperation = 'destination-in';
      octx.drawImage(segMask, dx, dy, dw, dh);
      octx.globalCompositeOperation = 'source-over';
    }
    octx.restore();

    ctx.clearRect(0, 0, w, h);
    ctx.save();
    ctx.shadowColor = avCfg.rimColor;
    ctx.shadowBlur = 14;
