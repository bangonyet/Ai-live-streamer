    const im = new Image();
    im.crossOrigin = 'anonymous';
    im.onload = async () => {
      rawImg = im;
      if (segmenter) await segmenter.send({ image: im });
      autoSaveAvatarCloud();
    };
    im.src = src;
  };

  // Sisipkan UI Slide 3
  const s3Html = `
  <div id="s3" class="slide">
    <h2>3. Studio Avatar AI Realistik</h2>
    <p class="sub">Penghapus latar otomatis, pencahayaan studio, & kalibrasi ekspresi wajah</p>
    <div class="grid" style="grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:12px;align-items:start">
      <div class="card" style="cursor:default;padding:12px;background:#070b14;border-color:#2dd4bf">
        <div style="font-size:11px;font-weight:bold;color:#2dd4bf;margin-bottom:6px">✨ Preview Host AI (Auto Cutout)</div>
        <div style="position:relative;width:185px;aspect-ratio:3/4;margin:0 auto;border-radius:14px;overflow:hidden;border:2px solid #38bdf8;background:radial-gradient(circle at 50% 30%, #1e293b, #050811)">
          <canvas id="avRealCvs" width="360" height="480" style="width:100%;height:100%"></canvas>
          <button type="button" onclick="speakTextSafe('Halo semuanya! Selamat datang di live streaming hari ini!')" style="position:absolute;bottom:8px;left:8px;right:8px;padding:7px;border-radius:8px;border:none;background:#38bdf8;color:#0f172a;font-size:11px;font-weight:bold;cursor:pointer">🗣️ Tes Bicara & Ekspresi</button>
        </div>
        <div id="avCloudStat" style="font-size:10px;color:#34d399;margin-top:6px">● AI Cutout & Kedip Mata Aktif</div>
      </div>
      <div style="text-align:left;display:flex;flex-direction:column;gap:8px">
        <div class="card" style="padding:10px;cursor:default;text-align:left">
          <div style="font-size:11.5px;font-weight:bold;color:#38bdf8;margin-bottom:6px">📐 Proporsi & Posisi Tubuh</div>
