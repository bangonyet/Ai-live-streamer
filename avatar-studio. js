            <button type="button" class="btn" style="padding:6px;font-size:10.5px;margin:0;border-color:#fbbf24" onclick="avCfg.rimColor='#fbbf24'">Warm Studio</button>
            <button type="button" class="btn" style="padding:6px;font-size:10.5px;margin:0;border-color:#c084fc" onclick="avCfg.rimColor='#c084fc'">Neon Glow</button>
          </div>
        </div>
        <div class="card" style="padding:10px;cursor:default;text-align:left">
          <label style="display:flex;align-items:center;gap:8px;font-size:11.5px;color:#e2e8f0;cursor:pointer">
            <input type="checkbox" checked onchange="avCfg.blurBg=this.checked" style="accent-color:#10b981">
            <span>Hapus Latar Asli (Transparan Studio)</span>
          </label>
        </div>
      </div>
    </div>
    <div style="display:flex;gap:8px;margin-top:12px">
      <button type="button" class="btn" style="flex:1;margin:0" onclick="go(2)">← Ganti Foto</button>
